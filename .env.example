# AI-OdooFinder Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE (PostgreSQL with pgvector)
# =============================================================================
# For local development with Docker:
DATABASE_URL=postgresql://odoofinder:your_password@localhost:5432/ai_odoofinder

# For production (server):
# DATABASE_URL=postgresql://odoofinder:your_password@db:5432/ai_odoofinder

# Docker Compose variables
POSTGRES_DB=ai_odoofinder
POSTGRES_USER=odoofinder
POSTGRES_PASSWORD=

# =============================================================================
# EXTERNAL APIs
# =============================================================================
# OpenRouter - Required for embeddings generation
OPENROUTER_API_KEY=

# GitHub - Optional, for higher API rate limits during ETL
GH_TOKEN=

# =============================================================================
# APPLICATION
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
